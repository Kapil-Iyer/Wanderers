# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (optional; for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev only: skip the real OTP/recovery email send (Supabase's default sender
# can time out locally, e.g. 504s, or be blocked for @uwaterloo.ca) and
# return the OTP code / recovery link directly in the login and
# forgot-password API responses instead. Never enabled in production
# regardless of this value (guarded by NODE_ENV in the route code).
# AUTH_RETURN_RECOVERY_LINK=true

# Google Maps (optional; for map and bubbles)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID enables the vector renderer → real 3D building extrusions on the map.
# Create one at: Google Cloud Console → Google Maps Platform → Map Management
# → Create Map ID → type: JavaScript, tilting: enabled, style: Dark
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Gemini (optional; for intent parsing in Create Bubble)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ML recommendations (optional; FastAPI service URL)
RECOMMENDATIONS_API_URL=

# Campus email gate.
# Set REQUIRE_UW_EMAIL=true in Vercel environment variables to enforce the
# UWaterloo email gate in production (only @uwaterloo.ca can sign up / log in).
# When false, missing, or any other value, any valid email is allowed through.
# NEXT_PUBLIC_REQUIRE_UW_EMAIL mirrors it for the client-side AuthModal check
# (client components can't read the non-public REQUIRE_UW_EMAIL).
REQUIRE_UW_EMAIL=true
NEXT_PUBLIC_REQUIRE_UW_EMAIL=true
