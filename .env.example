# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (optional; for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps (optional; for map and bubbles)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID enables the vector renderer → real 3D building extrusions on the map.
# Create one at: Google Cloud Console → Google Maps Platform → Map Management
# → Create Map ID → type: JavaScript, tilting: enabled, style: Dark
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Gemini (optional; for intent parsing in Create Bubble)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ML recommendations (optional; FastAPI service URL)
RECOMMENDATIONS_API_URL=
