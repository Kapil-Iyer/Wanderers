# Copy this file to .env and fill in values.
# Same Supabase project/anon key as the web app's .env.local
# (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# LAN IP of the machine running `npm run dev` (root repo), e.g. http://192.168.1.23:3000
# Find it via `ipconfig` (Windows). Needed because mobile can't use relative
# /api/... paths like the web app does.
EXPO_PUBLIC_API_BASE_URL=
