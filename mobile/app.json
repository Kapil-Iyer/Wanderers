{
  "expo": {
    "name": "Wanderers",
    "slug": "wanderers-mobile",
    "scheme": "wanderers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wanderers.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.wanderers.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0b0710",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wanderers uses your location to show nearby bubbles on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wanderers uses your photo library so you can post a Wander Moment photo from an event.",
          "cameraPermission": "Wanderers uses your camera so you can take a Wander Moment photo from an event.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d2fe21d2-ad4b-4d62-9928-64bba64aa577"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d2fe21d2-ad4b-4d62-9928-64bba64aa577"
    }
  }
}
